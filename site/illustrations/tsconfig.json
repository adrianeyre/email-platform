{
  // The illustrations and the vendored Stageshow kit, checked with the kit's
  // own settings (strict, bundler resolution), as the kit is copied as it is.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [".", "../stageshow/kit"]
}
