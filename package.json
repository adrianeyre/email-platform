{
  "name": "email-platform",
  "version": "1.0.0",
  "description": "Self-hosted email templates and sending: a REST API that renders Handlebars templates and sends through your SMTP provider, with users, API keys, templates, settings and logs in its own Postgres",
  "license": "ISC",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p release && tsc -p site && tsc -p site/illustrations",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "prettier": "prettier . --check",
    "prettier:write": "prettier . --write",
    "format": "pnpm run lint:fix && pnpm run prettier:write",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "start": "node --enable-source-maps dist/src/index.js",
    "run:local": "tsx --env-file-if-exists=.env src/index.ts",
    "local": "pnpm run \"/^local:(api|worker)$/\"",
    "local:api": "pnpm run:local api",
    "local:worker": "pnpm run:local worker",
    "dev:ui": "vite",
    "migrate": "tsx --env-file-if-exists=.env src/index.ts migrate",
    "cli": "tsx --env-file-if-exists=.env src/index.ts cli",
    "db:generate": "drizzle-kit generate",
    "deploy:server": "sh ops/deploy-server.sh",
    "site:build": "node site/build.ts",
    "site:dev": "node site/build.ts --dev",
    "site:preview": "node site/build.ts --preview",
    "site:film": "node site/film.ts",
    "restore": "docker compose --profile restore run --rm restore restore.sh"
  },
  "pre-commit": [
    "lint",
    "prettier",
    "test"
  ],
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "@fastify/swagger": "^9.9.4",
    "@fastify/swagger-ui": "^6.1.4",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-subscript": "^3.34.0",
    "@tiptap/extension-superscript": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "handlebars": "^4.7.10",
    "html-to-text": "^10.0.1",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fastify/pre-commit": "^2.2.2",
    "@redocly/openapi-core": "^2.79.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "lucide-react": "0.468.0",
    "playwright-core": "~1.48.2",
    "prettier": "^3.10.1",
    "semantic-release": "^26.0.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
