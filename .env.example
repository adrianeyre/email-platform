# Development values for the stack in docker-compose.dev.yml.
DATABASE_URL=postgres://email_platform@localhost:54321/email_platform
PORT=4320
APP_URL=http://localhost:4320
# Left empty so no install starts with a key from the repository: make one with `openssl rand -base64 32` (#165).
ENCRYPTION_KEY=

# Production only (docker-compose.yml)
# The host address the api's port 4320 is published on. Empty is 127.0.0.1, this server alone: set it to the server's
# LAN or tailnet address, never 0.0.0.0, and filter it in DOCKER-USER (docs/operations/deploying.md#the-published-port).
API_BIND_ADDRESS=
# The Postgres superuser's password: only the postgres and provision containers get it. Make it, like each password
# below, with `openssl rand -hex 32`: provision refuses one under 16 characters, with whitespace, or one character repeated.
POSTGRES_PASSWORD=
# One password per container's role (docs/operations/deploying.md#database-roles). Make each with `openssl rand -hex 32`.
DATABASE_MIGRATE_PASSWORD=
DATABASE_API_PASSWORD=
DATABASE_WORKER_PASSWORD=
DATABASE_BACKUP_PASSWORD=
BACKUP_AGE_RECIPIENT=
BACKUP_RCLONE_REMOTE=
BACKUP_RCLONE_CONFIG_FILE=
BACKUP_KEEP_DAYS=14
# Leave unset: the remote's lifecycle rule deletes old backups (docs/operations/backups-and-restore.md).
BACKUP_PRUNE_RCLONE_REMOTE=
BACKUP_HOUR_UTC=2
